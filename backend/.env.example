APP_NAME=TSlurmOps API
API_V1_PREFIX=/api/v1
DEBUG=false

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_DATABASE_URL=mysql+pymysql://insight_admin_user:change-me@127.0.0.1:3306/insight_admin?charset=utf8mb4
USER_DATABASE_URL=mysql+pymysql://desk_user_user:change-me@127.0.0.1:3306/desk_users?charset=utf8mb4

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TERMINAL_TARGETS=master,node-a,node-b
TD_API_KEY=change-me-td-api-key
SLURM_RESERVATION_MOCK=true
SLURM_REST_BASE_URL=http://slurmrestd:6820
SLURM_REST_API_VERSION=v0.0.44
SLURM_REST_USER_NAME=
SLURM_REST_USER_TOKEN=

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me
INITIAL_ADMIN_NAME=Administrator

# LSC(OpenLDAP 동기화) 원격 실행 — 승인 시 SSH로 스크립트 실행
LSC_SYNC_ENABLED=true
LSC_SSH_HOST=192.168.0.125
LSC_SSH_PORT=10022
LSC_SSH_USER=root
LSC_SSH_KEY_PATH=
LSC_SSH_TIMEOUT=120
LSC_SYNC_COMMAND=/usr/local/bin/lsc-sync-now.sh && /usr/local/bin/make_home.sh

OVERVIEW_URL=
NODE_URL=
JOB_URL=
GPU_URL=
POWER_URL=
K8S_URL=
SNMP_URL=

# Delivery profile: llm or hpc. Restart backend after changing.
PRODUCT_PROFILE=llm
RESOURCE_RESERVATIONS_ENABLED=true
TERMINAL_ENABLED=true
VLLM_URL=
VLLM_OBSERVABILITY_URL=
TRACE_URL=
USER_TRACE_URL=

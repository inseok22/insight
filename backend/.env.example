# 로컬 실행: python -m app.serve가 이 포트를 읽습니다. Vite 개발 시 deploy/.env와 맞춥니다.
BACKEND_PORT=18000

APP_NAME=TSlurmOps API
API_V1_PREFIX=/api/v1
DEBUG=false

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ADMIN_DATABASE_URL=mysql+pymysql://insight_admin_user:change-me@127.0.0.1:3306/insight_admin?charset=utf8mb4
USER_DATABASE_URL=mysql+pymysql://desk_user_user:change-me@127.0.0.1:3306/desk_users?charset=utf8mb4

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TERMINAL_TARGETS=master,node-a,node-b
TD_API_KEY=change-me-td-api-key
SLURM_REST_BASE_URL=http://slurmrestd:6820
SLURM_REST_API_VERSION=v0.0.44
SLURM_REST_USER_NAME=
SLURM_REST_USER_TOKEN=

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_NAME=Administrator

# 초기 계정은 admin/admin 하나입니다. 비밀번호는 INITIAL_ADMIN_PASSWORD_HASH로 설정합니다.
# 이전 설정과의 호환용 키입니다. true여도 서버 시작 시 데모 계정을 생성하지 않습니다.
SEED_DEMO_ACCOUNTS=false

# LSC(OpenLDAP 동기화) 원격 실행 — 승인 시 SSH로 스크립트 실행
LSC_SYNC_ENABLED=true
LSC_SSH_HOST=192.168.0.125
LSC_SSH_PORT=10022
LSC_SSH_USER=root
LSC_SSH_KEY_PATH=
LSC_SSH_TIMEOUT=120
LSC_SYNC_COMMAND=/usr/local/bin/lsc-sync-now.sh && /usr/local/bin/make_home.sh

OVERVIEW_URL=
JOB_URL=
POWER_URL=
K8S_URL=
SNMP_URL=

# Delivery profile: llm or hpc. Restart backend after changing.
PRODUCT_PROFILE=llm
RESOURCE_RESERVATIONS_ENABLED=true
TERMINAL_ENABLED=true
VLLM_OBSERVABILITY_URL=
TRACE_URL=
USER_TRACE_URL=

# 환경별 화면 구성: 기존 회사/EICN profile / 한국공항공사 kac / 기존 1대 폐쇄망 도구 gpu_llm.
# 채팅 추가만을 위해 운영 환경의 기존 MONITORING_SCOPE를 변경하지 않습니다.
MONITORING_SCOPE=profile
# docs/kac-dashboard-urls.env.example 및 docs/kac-dashboard-urls.md 참고.
# ===== 한국공항공사: 아래 세 URL 설정을 현장에서 수정 =====
# [GPU 주소 수정] 여러 서버/GPU를 볼 수 있는 Grafana 대시보드 전체 URL 1개입니다.
# 예시: GPU_URL='https://grafana.example.test/d/gpu?orgId=1&kiosk=true'
GPU_URL=

# [Server 주소 수정] 여러 서버를 볼 수 있는 Grafana 대시보드 전체 URL 1개입니다.
# 예시: NODE_URL='https://grafana.example.test/d/server?orgId=1&kiosk=true'
NODE_URL=

# [LLM 주소 수정] LLM 관제용 Grafana 대시보드 전체 URL 1개입니다.
# 예시: VLLM_URL='https://grafana.example.test/d/llm?orgId=1&kiosk=true'
# 이전의 [{"id":...,"name":...,"url":...}] 목록은 URL 문자열 하나로 교체합니다.
# LLM 서비스 선택은 Grafana 내부에서 처리합니다. Insight의 서비스 탭/더보기는 없습니다.
VLLM_URL=

# [미설정] URL이 비어 있으면 주소 미설정 안내만 표시합니다. JSON 배열([] 포함)은 넣지 않습니다.
# [URL 형식] HTTP(S) 전체 URL을 사용하고 사용자명/비밀번호/비밀 토큰을 포함하지 않습니다.
# [서버/GPU/LLM 선택] Grafana 내부에서 관리합니다. 위 세 URL 키를 중복 선언하지 않습니다.
# [백엔드 포트] Compose 배포는 deploy/.env의 BACKEND_PORT에서 수정합니다(.env.backend 아님).
# [반영] 최초 전환 시 새 프론트/백엔드 배포 필요. 이후 URL/포트 변경은 이미지/프론트 재빌드 불필요.
# [Compose 반영] deploy에서 docker compose up -d --no-deps --no-build --pull never --force-recreate backend
# URL 변경 후 브라우저를 새로고침합니다. 포트 변경 시 Nginx proxy_pass 포트도 맞춰 reload합니다.
# ===== 한국공항공사 현장 수정 끝 =====
# 폐쇄망 초기 관리자: delivery/offline 도구가 PBKDF2-HMAC-SHA256 해시를 생성합니다.
# 직접 입력할 때는 전체 해시를 작은따옴표로 감싸 Compose의 $ 변수 치환을 막습니다.
# INITIAL_ADMIN_PASSWORD_HASH='<생성한 전체 해시>'

# ===== 회사·한국공항공사 공통 채팅 (Compose는 환경별 deploy/.env.backend에서 설정) =====
# 시연 프론트는 /api/v1/chat/을 사용하므로 API_V1_PREFIX=/api/v1을 유지합니다.
# false이면 메뉴·직접 채팅 URL·채팅 API를 함께 비활성화합니다.
DEMO_CHAT_ENABLED=false
# 해당 환경의 실제 vLLM API 루트. /v1을 포함하고 /chat/completions는 붙이지 않습니다.
# 예: http://vllm.example.test:8001/v1 — 회사 주소를 확인해 설정하며 현장 주소를 재사용하지 않습니다.
VLLM_API_BASE_URL=
# 실제 서비스 모델 ID. 비우면 /v1/models 조회; 여러 모델이면 정확한 ID를 직접 지정합니다.
VLLM_MODEL=
# 선택 항목: vLLM 인증에 필요한 키. 브라우저/VITE_*에는 넣지 않습니다.
VLLM_API_KEY=
# vLLM 요청 시간 제한(초). Nginx 채팅 location의 timeout보다 짧게 설정합니다.
VLLM_TIMEOUT_SECONDS=120
# 백엔드 컨테이너에서 접근할 SDK 수집용 루트(예: http://langfuse.example.test:3000).
# /api/public/ingestion, 프로젝트/Trace 화면 경로를 붙이지 않습니다.
# 브라우저 iframe VLLM_OBSERVABILITY_URL과 별도로 관리합니다.
LANGFUSE_BASE_URL=
# 실제 키는 해당 환경의 .env.backend에만 입력하며 예제/Git/로그에 남기지 않습니다.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 수집만 끄려면 false. 채팅은 DEMO_CHAT_ENABLED로 별도 제어합니다.
# true여도 URL/키 누락 시 일반 경고와 함께 수집만 비활성화하고 채팅은 유지합니다.
LANGFUSE_TRACING_ENABLED=false
# 연결 설정 변경은 backend 재생성으로 적용; 이미지 재빌드 불필요. docs/demo-chat.md 참고.
INITIAL_ADMIN_PASSWORD_HASH='pbkdf2_sha256$600000$cfc9e4f2c4da0be0a155ed4046a9a6e0$a5jBnIQ1+8FhNxy/QKARia1k52gLNOYcRttsYFpD/Hs='

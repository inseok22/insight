# 한국공항공사: 운영 env 전체를 교체하지 말고 아래 네 키만 반영합니다.
MONITORING_SCOPE=kac

# ===== 한국공항공사: 아래 세 URL 설정을 현장에서 수정 =====
# [GPU 주소 수정] 여러 서버/GPU를 볼 수 있는 Grafana 대시보드 전체 URL 1개입니다.
# 예시: GPU_URL='https://grafana.example.test/d/gpu?orgId=1&kiosk=true'
GPU_URL=

# [Server 주소 수정] 여러 서버를 볼 수 있는 Grafana 대시보드 전체 URL 1개입니다.
# 예시: NODE_URL='https://grafana.example.test/d/server?orgId=1&kiosk=true'
NODE_URL=

# [LLM 추가/삭제] 아래 VLLM_URL의 [] 안에 서비스별 {id, name, url}을 추가/삭제합니다.
# [LLM 이름 수정] name만 바꾸고 id는 유지합니다. 등록 순서대로 탭이 표시됩니다.
# [LLM 주소 수정] 각 url에 해당 서비스의 Grafana 대시보드 전체 URL을 넣습니다.
# [LLM 2개 등록 예시] 아래 VLLM_URL='[]' 한 줄을 다음 내용으로 교체합니다.
# VLLM_URL='[
#   {"id":"airport-guide","name":"공항 안내 LLM","url":"https://grafana.example.test/d/airport-guide?orgId=1&kiosk=true"},
#   {"id":"document-search","name":"문서 검색 LLM","url":"https://grafana.example.test/d/document-search?orgId=1&kiosk=true"}
# ]'
# [이름 변경 예시] "name":"공항 안내 LLM" → "name":"고객 응대 LLM" (id는 유지)
# [주소 미정 예시] {"id":"airport-guide","name":"공항 안내 LLM","url":""}
# 예시를 적용할 때 줄 앞의 #를 제거하고 주소를 실제 Grafana URL로 교체합니다.
# 서비스가 10개를 넘어도 같은 형식으로 추가합니다. 더보기는 화면 너비가 부족할 때 나타납니다.
VLLM_URL='[]'

# [미설정] GPU_URL/NODE_URL이 비면 주소 미설정 안내, VLLM_URL이 []이면 LLM 미등록 안내입니다.
# [입력 형식] LLM id는 목록 내에서 고유해야 합니다. JSON 내부에는 # 주석/마지막 쉼표를 넣지 않습니다.
# [URL 형식] HTTP(S) 전체 URL을 사용하고 사용자명/비밀번호/비밀 토큰을 포함하지 않습니다.
# [서버/GPU 선택] Grafana 내부에서 관리합니다. Insight의 서버별/GPU별 항목은 없습니다.
# [이전 설정] DASHBOARD_SERVERS는 삭제합니다. 위 세 URL 키를 파일 내에 중복 선언하지 않습니다.
# [반영] 이번 변경은 프론트/백엔드 재빌드·배포 필요. 이후 이름/URL/LLM 목록 변경은 재빌드 불필요.
# [Compose 반영] deploy에서 docker compose up -d --no-deps --no-build --pull never --force-recreate backend
# 백엔드 설정 반영 후 브라우저를 새로고침합니다. 로컬 실행이면 백엔드 프로세스를 재시작합니다.
# ===== 한국공항공사 현장 수정 끝 =====

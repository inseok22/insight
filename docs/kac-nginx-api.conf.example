# KAC 현장 검토용 기존 참고 예제입니다. 현재 회사 Nginx에 적용하지 않습니다.
# 공통 채팅만 검토할 때는 docs/nginx-chat.conf.example과 docs/demo-chat.md를 사용합니다.
# 실제 KAC 실행 방식·upstream·마운트 확인은 docs/kac-packaging-checklist.md의 향후 작업입니다.
# 아래는 호스트 Nginx를 가정한 예제이며 현재 라이브 설정을 확인한 결과가 아닙니다.
# 호스트에 설치된 Nginx의 기존 server { ... } 안에서 /api/ location을 검토합니다.
# 기존 location을 교체하고 중복으로 추가하지 마세요. root/try_files/TLS 설정은 유지합니다.
# 아래 18000을 deploy/.env의 BACKEND_PORT 값과 동일하게 수정합니다.
# Nginx는 deploy/.env를 자동으로 읽지 않습니다.
# 채팅 SSE 전용 설정입니다. /api/와 같은 server 블록에 두고 두 proxy_pass 포트를 함께 맞춥니다.
# 시연 프론트 경로와 일치하도록 백엔드 API_V1_PREFIX=/api/v1을 유지합니다.
# 기존 /grafana/, 정적 파일, 80번 listen 설정은 그대로 유지합니다.
location ^~ /api/v1/chat/ {
    proxy_pass http://127.0.0.1:18000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    gzip off;
    # 생성 중 응답/전송 대기 허용 시간. 애플리케이션 VLLM_TIMEOUT_SECONDS보다 길게 둡니다.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    send_timeout 3600s;
}

location /api/ {
    # 끝에 /를 붙이지 않아야 /api/... 경로가 그대로 백엔드에 전달됩니다.
    proxy_pass http://127.0.0.1:18000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

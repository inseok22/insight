# 공통 채팅 SSE location 참고 예제입니다. 실행 중인 Nginx에 자동 적용하지 않습니다.
# 기존 server와 일반 API location을 유지하고, 실제 upstream·인증/접근제어·헤더 설정을 먼저 확인합니다.
# 아래 127.0.0.1:18000은 호스트 Nginx 예시입니다. 회사 upstream을 확인한 값이 아닙니다.
# 컨테이너 Nginx에서 127.0.0.1은 그 컨테이너 자신이므로 실제 backend 주소를 유지해야 합니다.
# 프론트 경로에 맞춰 API_V1_PREFIX=/api/v1을 유지합니다.
location ^~ /api/v1/chat/ {
    # URI/마지막 / 없이 연결하여 /api/v1/chat/... 전체 경로를 FastAPI로 전달합니다.
    proxy_pass http://127.0.0.1:18000;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    gzip off;
    # 실제 VLLM_TIMEOUT_SECONDS보다 길게 설정합니다.
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    send_timeout 3600s;
}
